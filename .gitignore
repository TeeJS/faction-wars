# Godot 4 import cache and editor state - rebuilt by --import
.godot/
# Web export output
/build/
/export/

# Web export output
build/
version.txt

# Manual scans, PDFs and digests are copyrighted - never commit any of it.
manual/

# The original's artwork is never committed (docs/original-art-plan.md): players
# import their own art set. packs/*/original/ was its old home.
packs/*/original/
tools/FactionWarsExporter/bin/
tools/FactionWarsExporter/obj/
# The exporter's packaged build (tools/FactionWarsExporter/build.ps1).
tools/FactionWarsExporter/dist/
tools/FactionWarsExporter/*.zip
# A checkout's exported art sets (FactionWarsExporter --folder art/<set>): the
# player's own copy of the original's art, read by src/ui/artwork.gd. Never committed.
/art/
# Azure Trusted Signing material (dlib + metadata.json) - machine-local, never committed.
/.signing/
