<Project Sdk="Microsoft.NET.Sdk">

  <!-- Faction Wars Exporter: a small Windows utility for people who own Star
       Wars: Rebellion. It reads the pictures and text out of THEIR installed
       copy into one art-set file they import into Faction Wars (browser or
       desktop), and builds faction-pack files from a folder. The repo never
       distributes the original's art (docs/original-art-plan.md).

       Build, package and sign: build.ps1 beside this file (see README.md). It
       publishes ONE exe: self-contained, compressed, its data built in. Nothing is
       extracted to disk when it runs (there are no native libraries to unpack). -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FactionWarsExporter</AssemblyName>
    <RootNamespace>FactionWarsExporter</RootNamespace>
    <Version>2.4.4</Version>
    <Product>Faction Wars Exporter</Product>
    <Description>Exports the original artwork from your own copy of Star Wars: Rebellion into a file Faction Wars imports.</Description>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- Built into the exe (Importer.BuiltIn), so the exporter is one file.
         pack row id -> GOKRES.DLL portrait / miniature bitmap ids (see README). -->
    <EmbeddedResource Include="gokres_map.json" LogicalName="gokres_map.json" />
    <!-- The Star Wars pack's rows (ids, string_id, artwork_id): which picture
         belongs to which row, taken from the pack at build time. -->
    <EmbeddedResource Include="..\..\packs\star-wars-rebellion\characters.json" LogicalName="pack/characters.json" />
    <EmbeddedResource Include="..\..\packs\star-wars-rebellion\units.json" LogicalName="pack/units.json" />
    <EmbeddedResource Include="..\..\packs\star-wars-rebellion\facilities.json" LogicalName="pack/facilities.json" />
    <EmbeddedResource Include="..\..\packs\star-wars-rebellion\missions.json" LogicalName="pack/missions.json" />
    <EmbeddedResource Include="..\..\packs\star-wars-rebellion\map.json" LogicalName="pack/map.json" />
  </ItemGroup>

</Project>
